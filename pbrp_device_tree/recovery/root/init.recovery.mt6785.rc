# Recovery init for Redmi Note 8 Pro (begonia) - MT6785
#
# Brings up the MicroTrust TEE stack (teei_daemon + beanpod keymaster and
# gatekeeper) so that /data can be decrypted for:
#   * FDE       (Android 9)
#   * FBE v1    (Android 10/11)
#   * FBE v2    (Android 12 .. Android 16, incl. hardware wrapped keys)

import /microtrust_begonia.rc
import /init.begonia.rc

on early-init
    start adbd

on init
    # Standard /dev/block layout for scripts and the fstab by-name paths
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    # Needed for the retrofit super layout: expose /dev/block/mapper
    mkdir /dev/block/mapper 0770 root root

on early-fs
    write /proc/bootprof "INIT:early-fs"
    start vold

on fs
    write /proc/bootprof "INIT:fs"

on post-fs
    # Only relevant on non-dynamic firmware; harmless otherwise.
    write /proc/bootprof "INIT:post-fs"

# ---------------------------------------------------------------------------
# Encryption state handling
# ---------------------------------------------------------------------------
on property:ro.crypto.state=encrypted && property:ro.crypto.type=file && property:ro.pbrp.crypto=true
    install_keyring

# ---------------------------------------------------------------------------
# MicroTrust beanpod HAL services (needed for FBE wrapped-key decryption)
# ---------------------------------------------------------------------------
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    seclabel u:r:recovery:s0
    disabled

service keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    class hal
    user root
    group root drmrpc
    seclabel u:r:recovery:s0
    disabled

on property:hwservicemanager.ready=true && property:ro.pbrp.crypto=true
    write /proc/bootprof "start teei_daemon (on fs)"
    start teei_daemon
    write /proc/bootprof "start teei_daemon end (on fs)"
    start keymaster-4-0-beanpod
    start gatekeeper-1-0

# ---------------------------------------------------------------------------
# Tear the TEE/kernel services down once decryption is finished, or when the
# device is not encrypted at all. Keeping them alive upsets the RTC and
# random number generator only when they are useless anyway.
# ---------------------------------------------------------------------------
on property:ro.crypto.state=unsupported && property:ro.pbrp.crypto=true
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:ro.crypto.state=unencrypted && property:ro.pbrp.crypto=true
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:twrp.decrypt.done=true && property:ro.pbrp.crypto=true
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

# ---------------------------------------------------------------------------
# Retrofit dynamic partitions
#
# When a /super exists, make sure the device-mapper control nodes are usable
# before TWRP starts enumerating partitions.
# ---------------------------------------------------------------------------
on property:ro.boot.super_partition=*
    write /proc/bootprof "INIT: retrofitting super detected"
    mkdir /dev/block/mapper 0770 root root
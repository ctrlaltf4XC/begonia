# ---------------------------------------------------------------------------
# Runtime layout report (kept for scripts that still read ro.begonia.layout).
#
# Partition layout is NOT handled at runtime any more: one fstab cannot serve
# both stock (non-dynamic) and retrofit-dynamic (Android 11..16) firmware,
# because TWRP busy-waits on an unresolvable "logical" entry with no timeout.
# Two images are built (variants/) and flashed for the matching firmware.
# This script only reports which build-time variant is present.
# ---------------------------------------------------------------------------
on post-fs-data
    exec - root -- /system/bin/sh /sbin/begonia-layout-detect.sh

on property:ro.begonia.layout=dynamic
    write /proc/bootprof "BEGONIA: built with dynamic (retrofit super) image"

on property:ro.begonia.layout=non-dynamic
    write /proc/bootprof "BEGONIA: built with static (by-name) image"

# USB configuration for recovery on begonia (MT6785)
#
# The kernel hands us androidboot.usbconfigfs=true, so the gadget is built
# through /config/usb_gadget. The legacy /sys/class/android_usb/android0
# ffs node does not exist on A16 -- writing to it is a silent no-op, which is
# why adb never came up. Set VID/PID before the gadget is enabled: once UDC is
# bound the descriptors are latched and writes are rejected.

on init
    mkdir /config/usb_gadget 0770 root root

on boot
    write /sys/class/leds/lcd-backlight/brightness 1000

on property:sys.usb.config=mtp,adb
    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xff48

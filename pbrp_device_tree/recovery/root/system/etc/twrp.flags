# TWRP / PBRP partition flags for Redmi Note 8 Pro (begonia)
#
# Both partition layouts are exposed:
#   * Physical images via "flashimg=1" entries pointing at by-name devices
#     -> works on stock Android 9/10 (non-dynamic)
#   * Logical partitions from /super via /dev/block/mapper
#     -> works on Android 11..16 (retrofit dynamic)
#
# <mount_point>   <fstype>  <device>                                          <device2>            <flags>

# --- Boot chain -----------------------------------------------------------------
/boot              emmc     /dev/block/platform/bootdevice/by-name/boot         flags=backup=1;display="Boot";flashimg=1
/dtbo              emmc     /dev/block/platform/bootdevice/by-name/dtbo         flags=backup=1;display="DTBO";flashimg=1
/recovery          emmc     /dev/block/platform/bootdevice/by-name/recovery     flags=backup=1;display="Recovery";flashimg=1
/vbmeta            emmc     /dev/block/platform/bootdevice/by-name/vbmeta       flags=backup=1;display="VBMeta";flashimg=1
/vbmeta_system     emmc     /dev/block/platform/bootdevice/by-name/vbmeta_system flags=backup=1;display="VBMeta System";flashimg=1
/lk                emmc     /dev/block/platform/bootdevice/by-name/lk           flags=backup=1;display="LK";flashimg=1
/lk2               emmc     /dev/block/platform/bootdevice/by-name/lk2          flags=backup=1;display="LK2";flashimg=1
/tee1              emmc     /dev/block/platform/bootdevice/by-name/tee1         flags=backup=1;display="TEE1";flashimg=1
/tee2              emmc     /dev/block/platform/bootdevice/by-name/tee2         flags=backup=1;display="TEE2";flashimg=1

# --- Dynamic super (retrofit) ---------------------------------------------------
# begonia has no physical by-name/super node. The dynamic recovery path creates
# its logical super entry from the selected fstab; only physical backing
# extents belong in twrp.flags.
/system            emmc     /dev/block/platform/bootdevice/by-name/system       flags=display="System (raw)";backup=1;flashimg=1
/vendor            emmc     /dev/block/platform/bootdevice/by-name/vendor       flags=display="Vendor (raw)";backup=1;flashimg=1

# --- Filesystem view ------------------------------------------------------------
# Note: TWRP resolves the logical partitions in /super through the fstab, NOT
# through twrp.flags. Listing them here with mapper paths would break backup on
# non-dynamic firmware, so only the physical by-name devices are declared.
/system_root      ext4     /dev/block/platform/bootdevice/by-name/system       flags=display="System";backup=1;wipeingui
/vendor           ext4     /dev/block/platform/bootdevice/by-name/vendor       flags=display="Vendor";backup=1;wipeingui

/cache            ext4     /dev/block/platform/bootdevice/by-name/cache        flags=backup=1;display="Cache";wipeingui
# --- MediaTek / vendor factory partitions ---------------------------------------
/metadata         ext4     /dev/block/platform/bootdevice/by-name/metadata     flags=backup=1;display="Metadata"
/persist          ext4     /dev/block/platform/bootdevice/by-name/persist      flags=backup=1;display="Persist"
/persist_image    emmc     /dev/block/platform/bootdevice/by-name/persist      flags=backup=1;display="Persist Image";flashimg=1
/nvram            emmc     /dev/block/platform/bootdevice/by-name/nvram        flags=backup=1;display="NVRAM"
/nvdata           ext4     /dev/block/platform/bootdevice/by-name/nvdata       flags=backup=1;display="NVDATA"
/nvcfg            ext4     /dev/block/platform/bootdevice/by-name/nvcfg        flags=backup=1;display="NVCFG"
/protect_f        ext4     /dev/block/platform/bootdevice/by-name/protect1     flags=backup=1;display="Protect F"
/protect_s        ext4     /dev/block/platform/bootdevice/by-name/protect2     flags=backup=1;display="Protect S"
/para             emmc     /dev/block/platform/bootdevice/by-name/para         flags=backup=1;display="Para"
/misc             emmc     /dev/block/platform/bootdevice/by-name/misc         flags=backup=1;display="Misc"
/expdb            emmc     /dev/block/platform/bootdevice/by-name/expdb        flags=backup=1;display="Expdb"
/logo             emmc     /dev/block/platform/bootdevice/by-name/logo         flags=backup=1;display="Logo";flashimg=1
/proinfo          emmc     /dev/block/platform/bootdevice/by-name/proinfo      flags=backup=1;display="Proinfo"
/seccfg           emmc     /dev/block/platform/bootdevice/by-name/seccfg       flags=backup=1;display="Seccfg";flashimg=1
/md1img           emmc     /dev/block/platform/bootdevice/by-name/md1img       flags=backup=1;display="MD1IMG"
/md1dsp           emmc     /dev/block/platform/bootdevice/by-name/md1dsp       flags=backup=1;display="MD1DSP"
/scp1             emmc     /dev/block/platform/bootdevice/by-name/scp1         flags=backup=1;display="SCP1"
/scp2             emmc     /dev/block/platform/bootdevice/by-name/scp2         flags=backup=1;display="SCP2"
/sspm_1           emmc     /dev/block/platform/bootdevice/by-name/sspm_1       flags=backup=1;display="SSPM1"
/sspm_2           emmc     /dev/block/platform/bootdevice/by-name/sspm_2       flags=backup=1;display="SSPM2"
/spmfw            emmc     /dev/block/platform/bootdevice/by-name/spmfw        flags=backup=1;display="SPMFW"
/audio_dsp        emmc     /dev/block/platform/bootdevice/by-name/audio_dsp    flags=backup=1;display="audio_dsp"
/gz1              emmc     /dev/block/platform/bootdevice/by-name/gz1          flags=backup=1;display="GZ1"
/gz2              emmc     /dev/block/platform/bootdevice/by-name/gz2          flags=backup=1;display="GZ2"
/cam_vpu1         emmc     /dev/block/platform/bootdevice/by-name/cam_vpu1     flags=backup=1;display="cam_vpu1"
/cam_vpu2         emmc     /dev/block/platform/bootdevice/by-name/cam_vpu2     flags=backup=1;display="cam_vpu2"
/cam_vpu3         emmc     /dev/block/platform/bootdevice/by-name/cam_vpu3     flags=backup=1;display="cam_vpu3"
/frp              emmc     /dev/block/platform/bootdevice/by-name/frp          flags=backup=1;display="FRP"
/boot_para        emmc     /dev/block/platform/bootdevice/by-name/boot_para    flags=backup=1;display="boot_para"
/otp              emmc     /dev/block/platform/bootdevice/by-name/otp          flags=backup=1;display="OTP"

# --- External storage -----------------------------------------------------------
/external_sd      vfat     /dev/block/mmcblk0p1  /dev/block/mmcblk0   flags=display="MicroSD";storage;wipeingui;removable;fsflags="utf8"
/usbstorage       vfat     /dev/block/sdd1       /dev/block/sdd        flags=display="USB Storage";storage;wipeingui;removable;fsflags="utf8"